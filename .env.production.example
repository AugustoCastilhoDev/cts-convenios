# ==========================================================================
# CTS Convênios — variáveis de PRODUÇÃO (modelo)
#
#   cp .env.production.example .env.production
#
# O arquivo .env.production NUNCA vai para o Git (está no .gitignore): ele guarda os
# segredos do servidor. Este modelo só mostra o que preencher. Passo a passo completo
# em docs/PRODUCAO.md.
# ==========================================================================

# ---- Aplicação ----------------------------------------------------------
APP_NAME="CTS Convênios"
APP_ENV=production
# Gere com:  docker compose --env-file .env.production -f docker-compose.prod.yml run --rm --no-deps -e APP_KEY=base64:x app php artisan key:generate --show
# Guarde uma cópia da chave em local seguro: sem ela, dados criptografados ficam ilegíveis.
APP_KEY=
APP_DEBUG=false
# Endereço público do sistema. Sem domínio ainda, use http://IP-DO-SERVIDOR.
APP_URL=https://cts.seudominio.gov.br
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en

# ---- Endereço e HTTPS (Caddy) ---------------------------------------------
# Sem domínio:  SITE_ADDRESS=:80   (só HTTP, para homologar)
# Com domínio:  SITE_ADDRESS=cts.seudominio.gov.br  (HTTPS automático; DNS "A" apontando para o servidor)
SITE_ADDRESS=:80
# E-mail que o Let's Encrypt avisa se o certificado estiver para vencer.
ACME_EMAIL=
HTTP_PORT=80
HTTPS_PORT=443
# O Nginx só é alcançável pelo Caddy (rede interna do Docker): pode confiar nos cabeçalhos dele.
TRUSTED_PROXIES=*

# ---- Logs -----------------------------------------------------------------
# stderr = docker compose logs. Nível "warning" evita ruído e vazamento de detalhes.
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# ---- Banco de dados (PostgreSQL) ------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=database
DB_PORT=5432
DB_DATABASE=cts_convenios
DB_USERNAME=cts_app
# Senha longa e única (ex.: openssl rand -base64 32). Não reutilize a de outro sistema.
DB_PASSWORD=

# ---- Redis (cache e fila dos alertas) -------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
CACHE_STORE=redis
CACHE_PREFIX=cts_prod
QUEUE_CONNECTION=redis

# ---- Sessão / autenticação --------------------------------------------------
# O sistema autentica por token (Sanctum), não por sessão de navegador.
SESSION_DRIVER=array
BCRYPT_ROUNDS=12
# Duração do login em minutos (720 = 12 h). Depois disso a pessoa entra de novo.
SANCTUM_EXPIRATION_MINUTOS=720

# ---- Arquivos enviados ----------------------------------------------------
# Disco privado dentro do volume "cts_storage". Faça backup com scripts/backup.sh.
FILESYSTEM_DISK=local

# ---- E-mail dos alertas de prazo (Resend) ----------------------------------
MAIL_MAILER=resend
RESEND_API_KEY=
# O domínio do remetente precisa estar VERIFICADO no Resend (SPF/DKIM). Pendente até o domínio do CTS existir.
MAIL_FROM_ADDRESS="alertas@seudominio.gov.br"
MAIL_FROM_NAME="CTS Convênios"
# DEIXE VAZIO em produção. Se preenchido, TODOS os alertas vão só para este e-mail (modo de teste).
ALERTAS_REDIRECIONAR_PARA=

# ---- Formulário de contato da landing page ---------------------------------
# Quem recebe o aviso de cada pedido de demonstração. Vazio = só grava no banco.
CONTATO_DESTINO=
